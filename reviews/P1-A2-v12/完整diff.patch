+            if not stack:
+                return _Match("ORPHAN_CLOSE", start=pos, skip_to=ct[1])
+            if ct[0] != stack[-1]:
+                return _Match("MISMATCH", start=pos, skip_to=ct[1])
+            stack.pop()
+            if not stack:
+                return _Match("COMPLETE", start=pos, end=ct[1])
