+def _quotes_in(text: str, start: int, end: int, syntax_regions):
+    """同一段落内配对引号。返回 [(open_pos, close_pos+1)]。"""
+    out = []
+    pairs = {"“": "”", "‘": "’", "「": "」", "『": "』"}
+    stack = []
+    i = start
+    while i < end:
+        c = text[i]
+        if c in pairs:
+            stack.append((c, i))
+        elif c in pairs.values():
+            for j in range(len(stack) - 1, -1, -1):
+                oc, op = stack[j]
+                if pairs[oc] == c:
+                    del stack[j:]
+                    if not _in_same_syntax(op, i + 1, syntax_regions):
+                        out.append((op, i + 1))
+                    break
+        i += 1
