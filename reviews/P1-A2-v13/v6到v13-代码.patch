+                positions.append(i)
+            esc = 0
+        else:
+            esc = 0
+        i += 1
+    for k in range(0, len(positions) - 1, 2):
+        o, c2 = positions[k], positions[k + 1]
+        if not _in_same_syntax(o, c2 + 1, syntax_regions):
+            out.append((o, c2 + 1))
+    return out
+
